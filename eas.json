{
  "cli": {
    "version": ">= 3.12.0"
  },
  "build": {
    "fastDebug": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "APP_ENV": "development",
        "API_URL": "https://dev.example.com"
      },
      "preInstall": "pnpm install --no-frozen-lockfile"
    }
  }
}
